# API and worker
SUPABASE_URL=http://127.0.0.1:54321
# These existing variable names also accept the new sb_publishable_/sb_secret_ keys.
# Keep the secret key on the API/worker only; never put it in NEXT_PUBLIC_*.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379/0
PULSE_WEB_ORIGIN=http://localhost:3000
PULSE_CREDENTIAL_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
PULSE_ECHO_MODE=false
PULSE_LLM_CHAT_URL=
PULSE_LLM_MODEL=
PULSE_LLM_API_KEY=
PULSE_LLM_DISABLE_THINKING=false

# Docker Compose staging values; keep each URL consistent with the host below.
PULSE_APP_HOST=
PULSE_API_HOST=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
