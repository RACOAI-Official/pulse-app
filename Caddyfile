{$PULSE_APP_HOST} {
  # Marketing site (apps/landing) owns the root page and its own assets;
  # everything else is the platform (apps/web).
  @landing path / /landing-assets/* /media/* /brand-mark.svg /icon.svg
  handle @landing {
    reverse_proxy landing:3000
  }
  handle {
    reverse_proxy web:3000
  }
}

{$PULSE_API_HOST} {
  reverse_proxy api:8000
}
